{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["scenario_id", "family_id", "language", "script", "media_status"],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "language": {"enum": ["en", "zh", "en-zh"]},
    "media_status": {"const": "synthetic_text_only"},
    "script": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["role", "text"], "additionalProperties": false,
      "properties": {"role": {"enum": ["caller", "recipient"]}, "text": {"type": "string", "minLength": 1, "maxLength": 8000}}
    }},
    "planned_synthetic_turn_indexes": {"type": "array", "items": {"type": "integer", "minimum": 0}}
  },
  "additionalProperties": false
}
